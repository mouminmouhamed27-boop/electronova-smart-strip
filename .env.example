# Server Configuration
PORT=5000
NODE_ENV=development

# Security & JWT
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d

# Unified EMQX Cloud Broker (MQTTS TLS Port 8883)
MQTT_BROKER_URL=mqtts://your-emqx-host.emqxsl.com:8883
MQTT_CLIENT_ID=ElectroNova_Backend_Server
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password
MQTT_TLS_REJECT_UNAUTHORIZED=true

# Unified Device ID & Topics (electronova/{deviceId}/cmd | state | status)
MQTT_DEVICE_ID=EN_SIM1
# Optional explicit overrides:
# MQTT_TOPIC_CMD=electronova/EN_SIM1/cmd
# MQTT_TOPIC_STATE=electronova/EN_SIM1/state
# MQTT_TOPIC_LWT=electronova/EN_SIM1/status

# Energy Tariff (EGP per kWh)
DEFAULT_TARIFF_EGP=1.25
